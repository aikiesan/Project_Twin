# data (tracked by DVC, never git) - only the small .dvc pointer files are committed
/data/**
!/data/*.dvc
!/data/.gitignore
/runs/
/exports/*/
!/exports/.gitkeep

# secrets
.env
*.env
credentials*.json
.dvc/config.local

# python
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/

# os/editor
.DS_Store
Thumbs.db
.vscode/
.idea/
